"""Test fixtures: a scripted OpenAI-compatible mock LLM and an ARC test client.

Managed by Armature. The mock lets the tests drive the real agent loop offline:
queue model steps with `mock_llm.script(...)`, then call the ARC API.
"""

from __future__ import annotations

import json
import socket
import threading
import time
from collections import deque
from typing import Any

import pytest
import uvicorn
from fastapi import FastAPI, Request
from fastapi.responses import JSONResponse, StreamingResponse
from fastapi.testclient import TestClient

from {{package}}.runtime.server import create_app
from {{package}}.settings import Settings


class MockLLM:
    """Replies with queued steps: {"text": ...} or {"tool_calls": [{"name": ..., "args": {...}}]}.

    With nothing queued it answers "Done.". Every request body is kept in `requests`.
    """

    def __init__(self) -> None:
        self.steps: deque[dict[str, Any]] = deque()
        self.requests: list[dict[str, Any]] = []
        self.calls = 0
        self.url = ""

    def script(self, *steps: dict[str, Any]) -> None:
        self.steps.extend(steps)

    def reset(self) -> None:
        self.steps.clear()
        self.requests.clear()

    def next_step(self) -> dict[str, Any]:
        return self.steps.popleft() if self.steps else {"text": "Done."}

    def tool_calls(self, step: dict[str, Any]) -> list[dict[str, Any]]:
        calls = []
        for call in step.get("tool_calls", []):
            self.calls += 1
            calls.append(
                {
                    "id": call.get("id") or f"call_{self.calls}",
                    "type": "function",
                    "function": {"name": call["name"], "arguments": json.dumps(call.get("args", {}))},
                }
            )
        return calls


def _usage() -> dict[str, int]:
    return {"prompt_tokens": 10, "completion_tokens": 5, "total_tokens": 15}


def _mock_app(mock: MockLLM) -> FastAPI:
    app = FastAPI()

    @app.post("/v1/chat/completions")
    async def completions(request: Request):
        body = await request.json()
        mock.requests.append(body)
        step = mock.next_step()
        if "error" in step:
            return JSONResponse({"error": {"message": step["error"], "type": "server_error"}}, status_code=500)
        calls = mock.tool_calls(step)
        text = step.get("text", "")
        finish = "tool_calls" if calls else "stop"
        base = {"id": "chatcmpl-mock", "created": 0, "model": body.get("model", "mock-model")}
        if not body.get("stream"):
            message: dict[str, Any] = {"role": "assistant", "content": text or None}
            if calls:
                message["tool_calls"] = calls
            return {
                **base,
                "object": "chat.completion",
                "choices": [{"index": 0, "message": message, "finish_reason": finish}],
                "usage": _usage(),
            }

        def chunk(delta: dict[str, Any], finish_reason: str | None = None) -> str:
            payload = {
                **base,
                "object": "chat.completion.chunk",
                "choices": [{"index": 0, "delta": delta, "finish_reason": finish_reason}],
            }
            return f"data: {json.dumps(payload)}\n\n"

        def events():
            yield chunk({"role": "assistant", "content": ""})
            for i in range(0, len(text), 8):
                yield chunk({"content": text[i : i + 8]})
            for index, call in enumerate(calls):
                yield chunk({"tool_calls": [{"index": index, **call}]})
            yield chunk({}, finish)
            if (body.get("stream_options") or {}).get("include_usage"):
                usage = {**base, "object": "chat.completion.chunk", "choices": [], "usage": _usage()}
                yield f"data: {json.dumps(usage)}\n\n"
            yield "data: [DONE]\n\n"

        return StreamingResponse(events(), media_type="text/event-stream")

    return app


@pytest.fixture(scope="session")
def mock_llm():
    mock = MockLLM()
    sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    sock.bind(("127.0.0.1", 0))
    port = sock.getsockname()[1]
    server = uvicorn.Server(uvicorn.Config(_mock_app(mock), log_level="warning"))
    thread = threading.Thread(target=server.run, kwargs={"sockets": [sock]}, daemon=True)
    thread.start()
    deadline = time.monotonic() + 10
    while not server.started:
        if time.monotonic() > deadline:
            raise RuntimeError("mock LLM did not start")
        time.sleep(0.01)
    mock.url = f"http://127.0.0.1:{port}/v1"
    yield mock
    server.should_exit = True
    thread.join(timeout=5)


def _settings(mock: MockLLM, tmp_path, eval_mode: bool) -> Settings:
    return Settings(
        model_mode="mock",
        mock_url=mock.url,
        eval_mode=eval_mode,
        session_db=str(tmp_path / "sessions.db"),
    )


@pytest.fixture
def client(mock_llm, tmp_path):
    """ARC client for the app in eval mode, so tests can stub tools."""
    mock_llm.reset()
    with TestClient(create_app(_settings(mock_llm, tmp_path, eval_mode=True))) as c:
        yield c


@pytest.fixture
def app_client(mock_llm, tmp_path):
    """ARC client for the app as it runs in production (eval mode off)."""
    mock_llm.reset()
    with TestClient(create_app(_settings(mock_llm, tmp_path, eval_mode=False))) as c:
        yield c
