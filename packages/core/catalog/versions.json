{
  "catalog_version": 1,
  "verified_at": "2026-11-12",
  "note": "Pins verified by installing into a clean Python 3.12 venv and running the adapter contract tests. Update only together with those tests.",
  "python": {
    "requires": ">=3.11",
    "default": "3.12",
    "supported": ["3.11", "3.12", "3.13"]
  },
  "common": {
    "fastapi": "0.162.5",
    "uvicorn": "0.54.0",
    "pydantic": "2.14.3",
    "httpx": "0.28.1",
    "jsonschema": "4.26.0"
  },
  "dev": {
    "pytest": "9.2.0"
  },
  "frameworks": {
    "langgraph": {
      "packages": {
        "langchain": "1.5.0",
        "langchain-core": "1.8.0",
        "langgraph": "1.2.21",
        "langgraph-checkpoint": "4.3.1",
        "langchain-openai": "1.7.4"
      },
      "providers": {
        "openai": {},
        "openai_compatible": {},
        "anthropic": {
          "langchain-anthropic": "1.7.10"
        }
      },
      "session_backends": {
        "memory": {},
        "sqlite": {
          "langgraph-checkpoint-sqlite": "3.1.3"
        }
      },
      "note": "langchain-openai is always installed: mock mode drives the agent through an OpenAI-compatible endpoint."
    },
    "openai-agents": {
      "packages": {
        "openai-agents": "0.24.0",
        "openai": "3.50.0"
      },
      "providers": {
        "openai": {},
        "openai_compatible": {}
      },
      "session_backends": {
        "memory": {},
        "sqlite": {}
      }
    }
  },
  "build": {
    "hatchling": "1.33.0"
  }
}
