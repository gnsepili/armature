{
  "name": "armature-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter ./packages/playground --filter ./packages/cli run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "schemas": "tsx scripts/export-schemas.ts",
    "test:integration": "vitest run --config tests-integration/vitest.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
